          {
            "@type": "FAQPage",
            "@id": "https://www.benchmarkmissoula.com/services/car-making-noise#faq",
            "mainEntity": [
              {
                "@type": "Question",
                "name": "How do I know if the noise is serious?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Metal-on-metal grinding - from the brakes or engine - warrants same-day attention. A rhythmic clunk or pop from the suspension or drivetrain should be checked within a week. Intermittent rattles and minor squeaks are lower urgency but worth diagnosing, since they often precede a more significant failure."
                }
              },
              {
                "@type": "Question",
                "name": "Why does my car make noise only when it's cold?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Lubricant in ball joints, wheel bearings, and CV joints thickens at low temperatures, which amplifies existing wear. Damping fluid in struts and shocks also stiffens in the cold. Noises that appear at startup and fade as the car warms up often indicate wear that will eventually show up year-round."
                }
              },
              {
                "@type": "Question",
                "name": "Do I need to pay a diagnostic fee just to find out what the noise is?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Yes. Tracing a noise to its source takes time and uses lift equipment, test drives, and diagnostic tools. The fee covers that labor. It's applied toward any repair we perform."
                }
              }
            ]
          }
        ]
