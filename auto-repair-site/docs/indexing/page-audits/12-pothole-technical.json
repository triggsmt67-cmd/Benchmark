          {
            "@type": "FAQPage",
            "@id": "https://www.benchmarkmissoula.com/services/pothole-damage-inspection#faq",
            "mainEntity": [
              {
                "@type": "Question",
                "name": "How do I know if hitting a pothole actually damaged my car?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Common signs include steering wheel vibration, the car drifting to one side, a flat or slow-leaking tire, a bubble or bulge in the sidewall, a visibly bent rim, or clunking sounds over bumps. Alignment damage has no obvious symptom right away - it shows up as uneven tire wear over the following weeks."
                }
              },
              {
                "@type": "Question",
                "name": "Is pothole damage covered by auto insurance?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Collision coverage typically covers pothole damage, subject to your deductible. Comprehensive coverage does not. If the repair cost is close to or less than your deductible, filing a claim may not make financial sense. Some Montana roads qualify for municipal damage claims, but those are rarely straightforward to pursue."
                }
              },
              {
                "@type": "Question",
                "name": "Can I drive after hitting a pothole if the car seems fine?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "If the tire is holding air and the car tracks straight, short-distance driving is generally okay. But alignment and suspension damage doesn't always feel obvious right away. After a hard hit, an inspection within a few days is a reasonable step - especially before a long drive on the highway."
                }
              }
            ]
          }
        ]
      }
